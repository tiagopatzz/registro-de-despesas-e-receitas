[flake8]
; ============================================================
; Analise de qualidade de codigo - Tarefa Final GCS
; ============================================================
; Tolerados (estilo do projeto - apenas cosmeticos):
;   E302/E301/E303/E305 - linhas em branco entre funcoes/classes
;   E701/E702/E704       - comandos compostos na mesma linha (if x: return)
;   W291/W293            - espacos em branco no fim de linha / linha vazia
;   E261                 - espacos antes de comentario inline
;   E128/E127/E126       - alinhamento de continuacao de linha
; MANTIDOS (reprovam o pipeline - erros que importam de verdade):
;   E999  -> erro de SINTAXE (essencial para a demo de bloqueio)
;   F841  -> variavel atribuida e nunca usada
;   F401  -> import nao utilizado
;   F811  -> redefinicao de funcao/variavel
;   F-checks de nomes indefinidos, etc.
max-line-length = 200
extend-ignore = E302, E301, E303, E305, E701, E702, E704, W291, W293, E261, E128, E127, E126, E124, E131
exclude = .git, __pycache__, .venv, migrations
